# ==============================================================================
# Unity Project .gitignore — Comprehensive Standard Configuration
# ==============================================================================

# Generated Unity directories
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
.utmp/

# Visual Studio / Visual Studio Code / JetBrains Rider caches & projects
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Log and diagnostic files
*.log
sysinfo.txt
crashlytics-build.properties

# Test result artifacts in root
/*.xml
/TestResults*/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Builds and package archives
*.apk
*.aab
*.unitypackage
*.app

# Meta files for ignored extensions (ensure real asset metas are tracked)
*.pidb.meta
*.pdb.meta
*.mdb.meta
